# Pinned inputs for native/libav/build.sh (sourced by the script; plain KEY=VALUE).
# Everything the build downloads is pinned here and checksum-verified.

# libav.js (https://github.com/Yahweasel/libav.js), tag + the commit it must resolve to.
LIBAVJS_TAG=v6.10.9.0
LIBAVJS_COMMIT=c80e885c3461f7bb7ea565c9631b34243ae0dbf1
LIBAVJS_REPO=https://github.com/Yahweasel/libav.js

# Emscripten SDK. libav.js's CI (.github/workflows/build-and-test.yaml at this tag)
# builds with emsdk 6.0.5.
EMSDK_VERSION=6.0.5
EMSDK_REPO=https://github.com/emscripten-core/emsdk.git
EMSDK_COMMIT=8f685c26ee9f672081e61e22c6aa60fa972d00a9

# FFmpeg release the libav.js tag builds (Makefile.m4: FFMPEG_VERSION 9.0), downloaded
# by libav.js's own makefile from https://ffmpeg.org/releases/ffmpeg-9.0.tar.xz
FFMPEG_VERSION=9.0
FFMPEG_SHA256=7f607a00dd0d28a729d5a4811205812eef01cf6ef6155025febb6f36a9062d52

# Other tarballs libav.js's makefiles fetch for this variant (zlib for compressed
# mov/matroska headers; emfiberthreads = libav.js's fiber shim). Verified after download.
ZLIB_VERSION=1.3.2
ZLIB_URL=https://www.zlib.net/fossils/zlib-1.3.2.tar.gz
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
EMFT_VERSION=1.3
EMFT_URL=https://github.com/Yahweasel/emfiberthreads/archive/refs/tags/v1.3.tar.gz
EMFT_SHA256=0fe933d7742de3b3213608e0fb087a1ae0d060604d5835f7c9cdfcee0fc8cbcb

# Name of the custom libav.js variant (outputs are libav-<name>.mjs etc).
VARIANT=acw-audio

# Optimisation flags passed to libav.js's makefile (its default is -Oz).
OPTFLAGS_DEFAULT=-Oz
