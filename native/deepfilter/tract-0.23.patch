+fn set_last_error(msg: impl AsRef<str>) {
+    // Interior NULs cannot be represented in a C string; drop them.
+    let msg = msg.as_ref().replace('\0', " ");
+    LAST_ERROR.with(|e| *e.borrow_mut() = CString::new(msg).ok());
