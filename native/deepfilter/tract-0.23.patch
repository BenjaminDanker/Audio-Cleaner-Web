+
+/// Best-effort text of a caught panic payload.
+fn panic_message(p: &(dyn std::any::Any + Send)) -> String {
+    if let Some(s) = p.downcast_ref::<&str>() {
+        (*s).to_string()
+    } else if let Some(s) = p.downcast_ref::<String>() {
+        s.clone()
+    } else {
+        "unknown panic".to_string()
+    }
+}
+
+/// Run `f`, turning both `Err` and (if the crate is built with `panic = "unwind"`) panics into
+/// `None` and recording the message for `df_last_error()`.
+fn guarded<T>(f: impl FnOnce() -> Result<T, String>) -> Option<T> {
+    match catch_unwind(AssertUnwindSafe(f)) {
+        Ok(Ok(v)) => Some(v),
+        Ok(Err(e)) => {
+            set_last_error(e);
+            None
+        }
+        Err(p) => {
+            set_last_error(format!("panic: {}", panic_message(&*p)));
+            None
+        }
+    }
+}
