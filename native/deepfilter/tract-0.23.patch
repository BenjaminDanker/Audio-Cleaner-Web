+
+/// Processes N consecutive frames in one call, which avoids the JS<->wasm call overhead (and a
+/// per-frame allocation) of `df_process_frame`.
+///
+/// Args:
+///     - df_state: Created via df_create()
+///     - input: `N * df_get_frame_length()` samples, i.e. a whole number of frames.
+///
+/// Returns:
+///     - The enhanced samples, same length as `input`. Throws if the input length is not a
+///       multiple of the frame length or processing fails.
+#[wasm_bindgen]
+pub unsafe fn df_process_frames(
+    st: *mut DFState,
+    input: &[f32],
+) -> Result<js_sys::Float32Array, JsError> {
+    let state = st.as_mut().ok_or_else(|| JsError::new("Invalid pointer"))?;
+    let hop = state.0.hop_size;
+    if input.len() % hop != 0 {
+        return Err(JsError::new(&format!(
+            "input length {} is not a multiple of the frame length {hop}",
+            input.len()
+        )));
+    }
+    let mut output = vec![0f32; input.len()];
+    for (inp, out) in input.chunks_exact(hop).zip(output.chunks_exact_mut(hop)) {
+        let inp = ArrayView2::from_shape((1, hop), inp).map_err(|e| JsError::new(&e.to_string()))?;
+        let out =
+            ArrayViewMut2::from_shape((1, hop), out).map_err(|e| JsError::new(&e.to_string()))?;
+        state
+            .0
+            .process(inp, out)
+            .map_err(|e| JsError::new(&format!("Failed to process DF frame: {e:#}")))?;
+    }
+    Ok(js_sys::Float32Array::from(output.as_slice()))
+}
