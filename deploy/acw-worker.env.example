# Non-secret worker settings: ~/audio-cleaner/secrets/acw-worker.env
ACW_ENV=production
ACW_PUBLIC_ORIGIN=https://mc-multi-world.space
ACW_BASE_PATH=/audio
# Workers never sign anything, but config loading requires a value in production.
ACW_SESSION_SECRET=worker-processes-do-not-use-this-value-xxxxxxxx
# Threads per file job (each worker runs one job at a time)
ACW_JOB_THREADS=4
ACW_WHISPER_MODEL=large-v3-turbo
ACW_WHISPER_LIVE_MODEL=small
ACW_STREAM_MAX_SESSIONS=24
# Operator alerts (ACW_ALERT_EMAIL, SMTP_*) are not set here: workers have no network and send no mail;
# crashes are reported by acw-alert@.service / acw-monitor, which read acw.env.
