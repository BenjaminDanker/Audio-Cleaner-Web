[Unit]
Description=Audio Cleaner GPU worker: heavy noise removal, Voice rebuild, fast transcription (no network)
OnFailure=acw-alert@%n.service

[Service]
Slice=acw.slice
Type=simple
WorkingDirectory=%h/audio-cleaner/app
Environment=PYTHONPATH=%h/audio-cleaner/app
Environment=ACW_WORKER_GPU=1
EnvironmentFile=%h/audio-cleaner/secrets/acw-worker.env
ExecStart=%h/audio-cleaner/venv-gpu/bin/python -m acw.worker.main
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @sandbox
SystemCallErrorNumber=EPERM
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_UNIX
# Batch work yields to live audio and the game servers.
Nice=10
CPUWeight=50
IOWeight=50
MemoryHigh=3G
MemoryMax=4G
TasksMax=200

[Install]
WantedBy=default.target
