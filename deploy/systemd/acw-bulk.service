[Unit]
Description=Audio Cleaner bulk transfers: uploads and result downloads only (127.0.0.1:8794)
OnFailure=acw-alert@%n.service
After=network-online.target

[Service]
Slice=acw.slice
Type=simple
WorkingDirectory=%h/audio-cleaner/app
Environment=PYTHONPATH=%h/audio-cleaner/app
EnvironmentFile=%h/audio-cleaner/secrets/acw.env
# Same hardening as acw-web. No live worker, no background loops: acw.bulk_app serves PUT /api/jobs/{id}/input,
# GET /api/jobs/{id}/outputs/{name} and /api/health only. ACW_DOWNLOAD_MBPS_TOTAL / ACW_UPLOAD_MBPS_* (acw.env) cap the
# bytes per second (docs/operations.md, "Bulk transfers").
ExecStart=%h/audio-cleaner/venv/bin/uvicorn acw.bulk_app:app --host 127.0.0.1 --port 8794 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-server-header \
    --timeout-keep-alive 30 --limit-concurrency 100 --no-access-log
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @sandbox
SystemCallErrorNumber=EPERM
SystemCallFilter=~@privileged
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
TasksMax=200
LimitNOFILE=4096

[Install]
WantedBy=default.target
