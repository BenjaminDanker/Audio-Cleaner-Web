[Unit]
Description=Audio Cleaner failure alert for %i (email)

[Service]
# Started by OnFailure=acw-alert@%n.service on every acw-* unit; %i is the failed unit.
Slice=acw.slice
Type=oneshot
WorkingDirectory=%h/audio-cleaner/app
Environment=PYTHONPATH=%h/audio-cleaner/app
Environment=XDG_RUNTIME_DIR=/run/user/%U
# SMTP settings + ACW_ALERT_EMAIL live in the web env file.
EnvironmentFile=%h/audio-cleaner/secrets/acw.env
ExecStart=%h/audio-cleaner/venv/bin/python -m acw.alerts unit-failed %i
TimeoutStartSec=60
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
