    # ---- Audio Cleaner (/audio) --------------------------------------------
    # API + live WebSocket: SSH reverse tunnel from primary-ram (127.0.0.1:18790).
    # Uploads, result downloads and release downloads (/audio/api/downloads/): their own tunnel and process (127.0.0.1:18794 -> acw-bulk), so a big transfer
    # never queues in front of live audio; if that upstream is down they fall back to 18790 (the main process
    # serves the same routes). Before using this file, the key must be allowed to listen on 18794 (docs/operations.md).
    # Static site (incl. the free in-browser denoiser) is served from this VPS,
    # so the free tier never touches the home connection.
    redir /audio /audio/ 308

    # Request bodies: only a file upload may be big. Everything else is small JSON, so it gets 64 KB (the app
    # enforces the same limit again and drops a body that stalls for 20 s: acw/bodylimit.py; Caddy's Caddyfile has no
    # per-body read timeout, `request_body { read_timeout }` exists only in its JSON config). The Stripe webhook gets 1 MB.
    # install-audio-route.sh also puts this in the GLOBAL OPTIONS block at the top of /etc/caddy/Caddyfile, so a client that
    # opens a connection and never finishes its headers is dropped:
    #     servers {
    #         timeouts {
    #             read_header 10s
    #         }
    #     }
    handle /audio/api/* {
        @acw_upload path_regexp ^/audio/api/jobs/[0-9a-f]{32}/input$
        # Result downloads and the release downloads (desktop installers, OBS plugin, model archive: the files live on
        # primary-ram, nothing is stored on this VPS) use the bulk upstream too, so they never queue in front of live audio.
        @acw_download path_regexp ^/audio/api/(jobs/[0-9a-f]{32}/outputs/|downloads/)
        @acw_webhook path /audio/api/stripe/webhook
        # The live WebSocket (audio frames; compression would only add delay) is never compressed.
        @acw_ws path /audio/api/stream/ws
        handle @acw_upload {
            request_body {
                max_size 4GB
            }
            reverse_proxy 127.0.0.1:18794 127.0.0.1:18790 {
                lb_policy first
                lb_try_duration 3s
                lb_try_interval 250ms
                fail_duration 30s
                health_uri /audio/api/health
                health_interval 10s
                health_timeout 3s
                header_up -X-Real-IP
                flush_interval -1
                transport http {
                    dial_timeout 5s
                    response_header_timeout 2m
                }
            }
        }
        handle @acw_download {
            request_body {
                max_size 64KB
            }
            reverse_proxy 127.0.0.1:18794 127.0.0.1:18790 {
                lb_policy first
                lb_try_duration 3s
                lb_try_interval 250ms
                fail_duration 30s
                health_uri /audio/api/health
                health_interval 10s
                health_timeout 3s
                header_up -X-Real-IP
                flush_interval -1
                transport http {
                    dial_timeout 5s
                    response_header_timeout 2m
                }
            }
        }
        handle @acw_ws {
            request_body {
                max_size 64KB
            }
            reverse_proxy 127.0.0.1:18790 {
                header_up -X-Real-IP
                flush_interval -1
                transport http {
                    dial_timeout 5s
                    response_header_timeout 2m
                }
            }
        }
        handle @acw_webhook {
            request_body {
                max_size 1MB
            }
            reverse_proxy 127.0.0.1:18790 {
                header_up -X-Real-IP
                flush_interval -1
                transport http {
                    dial_timeout 5s
                    response_header_timeout 2m
                }
            }
        }
        handle {
            # The JSON answers (the job list is the big one: ~45 kB for 50 jobs, ~6-8x smaller compressed). Only JSON
            # is compressed; uploads, result downloads and the WebSocket are handled above and left alone.
            encode {
                zstd
                gzip
                match {
                    header Content-Type application/json*
                }
            }
            request_body {
                max_size 64KB
            }
            reverse_proxy 127.0.0.1:18790 {
                header_up -X-Real-IP
                flush_interval -1
                transport http {
                    dial_timeout 5s
                    response_header_timeout 2m
                }
            }
        }
    }

    handle /audio/* {
        root * /var/www
        # Turnstile (human check on email sign-in) is NOT enabled. To enable it, set TURNSTILE_SITE_KEY and
        # TURNSTILE_SECRET in acw.env and change these three directives in the Content-Security-Policy below:
        #     script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com;
        #     frame-src https://challenges.cloudflare.com;
        #     connect-src 'self' https://challenges.cloudflare.com;
        # (frame-src is not in the policy yet: add it; without it default-src 'self' blocks the widget's frame.)
        header {
            Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
            Strict-Transport-Security "max-age=31536000"
            X-Content-Type-Options "nosniff"
            X-Frame-Options "DENY"
            Referrer-Policy "strict-origin-when-cross-origin"
            Cross-Origin-Opener-Policy "same-origin"
            Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
            -Server
        }
        @acw_immutable path /audio/assets/*
        header @acw_immutable Cache-Control "public, max-age=31536000, immutable"
        # The free in-browser tool's engine and model: only for signed-in
        # browsers (the home server checks the session and a daily cap per
        # account, so bots can't keep downloading the model). The files
        # themselves are still served from here.
        @acw_dfn path /audio/dfn/*
        forward_auth @acw_dfn 127.0.0.1:18790 {
            uri /audio/api/auth/asset-check
        }
        header @acw_dfn Cache-Control "private, max-age=604800"
        # The speech model's .onnx files are stored gzipped next to the originals (deploy/publish-web.sh) and served
        # that way (file_server below); say what they are, since the extension is unknown to Caddy.
        @acw_onnx path /audio/dfn/*.onnx
        header @acw_onnx Content-Type application/octet-stream
        # Every app route serves index.html: never cache it, only hashed assets.
        @acw_html not path /audio/assets/* /audio/dfn/*
        header @acw_html Cache-Control "no-cache"
        # App routes (/audio/app, /audio/login, ...) get index.html; a missing hashed script, a missing file under
        # assets/ dfn/ releases/ is a real 404, so a tab on an old page can tell it must reload.
        @acw_spa not path /audio/assets/* /audio/dfn/* /audio/releases/*
        try_files @acw_spa {path} /audio/index.html
        file_server {
            precompressed zstd gzip
        }
    }
    # Home server or tunnel down: answer API calls with a clear maintenance
    # status instead of a bare 502. The site itself is served from this VPS,
    # so it keeps loading and shows a maintenance notice.
    handle_errors 502 503 504 {
        @acw_api path /audio/api/*
        handle @acw_api {
            header Content-Type application/json
            header Cache-Control no-store
            header Retry-After 60
            respond `{"detail":"maintenance","message":"Audio Cleaner is taking a short break. Please try again in a little while."}` 503
        }
    }
    # -------------------------------------------------------------------------
