# Audio Cleaner web/API secrets: ~/audio-cleaner/secrets/acw.env (chmod 600).
# Only acw-web reads this file; the workers get acw-worker.env (no secrets).
ACW_ENV=production
ACW_PUBLIC_ORIGIN=https://mc-multi-world.space
ACW_BASE_PATH=/audio
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
ACW_SESSION_SECRET=
ACW_ADMIN_EMAILS=

# Sign-in providers (callback URLs: <origin><base>/api/auth/oauth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing mail (STARTTLS): magic-link sign-in AND operator alerts.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=SMTP_FROM=<your gmail>,
# SMTP_PASSWORD=<16-char app password from https://myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Operator alerts (acw-monitor, crash/failure hooks, OpenAI problems) are mailed here.
# Needs the SMTP_* settings above; until both are set, alerts only appear in the journal.
# Test: cd ~/audio-cleaner/app && set -a && . ../secrets/acw.env && set +a && ../venv/bin/python -m acw.alerts test
ACW_ALERT_EMAIL=silverjunk08@gmail.com

# Stripe (restricted key recommended; webhook endpoint <origin><base>/api/stripe/webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = add tax at checkout and on auto-reloads (needs Stripe Tax set up + registrations)
STRIPE_AUTOMATIC_TAX=0
STRIPE_TAX_CODE=txcd_10000000

# Premium transcription / captions
OPENAI_API_KEY=

# Cloudflare Turnstile for the email sign-in form (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
