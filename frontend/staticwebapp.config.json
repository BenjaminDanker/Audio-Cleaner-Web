{
  "routes": [
    { "route": "/login",  "redirect": "/.auth/login/github?post_login_redirect_uri=/dashboard" },
    { "route": "/logout", "redirect": "/.auth/logout?post_logout_redirect_uri=/" },
    { "route": "/dashboard", "allowedRoles": ["authenticated"] },
    { 
      "route": "/api/webhook-stripe", 
      "allowedRoles": ["anonymous"],
      "headers": {
        "Access-Control-Allow-Origin": "https://white-hill-074a3d510.2.azurestaticapps.net",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "*"
      }
    },
    { 
      "route": "/api/*", 
      "allowedRoles": ["authenticated"],
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "*"
      }
    }
  ],

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*", "/.auth/*", "/api/*"]
  },

  "responseOverrides": {
    "401": {
      "rewrite": "/index.html"
    }
  },

  "globalHeaders": {
    "content-security-policy":
      "default-src https: 'unsafe-inline' 'unsafe-eval'; object-src 'none'"
  },

  "platform": {
    "apiRuntime": "node:18"
  },

  "trailingSlash": "auto"
}
