# Example terraform.tfvars file
# Copy this to terraform.tfvars and customize

project_name = "audio-cleaner"
environment  = "dev"
location     = "Central US"

# Optional: specify resource group name
# resource_group_name = "my-custom-rg-name"

# Stripe Configuration
stripe_secret_key     = "sk_test_your_stripe_secret_key_here"
stripe_public_key     = "pk_test_your_stripe_public_key_here"
stripe_webhook_secret = "whsec_your_webhook_secret_here"
stripe_topup_price_id = "price_your_topup_price_id_here"

tags = {
  Project     = "AudioCleanerPro"
  Environment = "dev"
  Owner       = "YourName"
  ManagedBy   = "terraform"
}
