{
  "name": "audio-cleaner-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Audio Cleaner web frontend",
  "scripts": {
    "sync-dfn": "node scripts/sync-dfn.mjs",
    "sync-licenses": "node scripts/sync-licenses.mjs",
    "gen-rust-licenses": "node scripts/gen-rust-licenses.mjs",
    "predev": "node scripts/sync-licenses.mjs",
    "dev": "vite",
    "build": "node scripts/sync-dfn.mjs --if-missing && node scripts/sync-licenses.mjs && vite build",
    "preview": "vite preview",
    "test:fixtures": "bash tests/make-fixtures.sh",
    "test:e2e": "node tests/e2e.mjs",
    "test:free": "node tests/free.mjs",
    "test:live": "node tests/live.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:flac": "node tests/flac.mjs",
    "test:qa": "node tests/qa-fixes.mjs",
    "test:offline": "node tests/offline.mjs",
    "test:copy": "node tests/copy.mjs",
    "test:states": "node tests/states.mjs",
    "test:files": "node tests/files.mjs",
    "test:fixes": "node tests/fixes.mjs",
    "test:contact": "node tests/contact.mjs"
  },
  "dependencies": {
    "mediabunny": "^1.61.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.58.2",
    "vite": "^6.4.4"
  }
}
