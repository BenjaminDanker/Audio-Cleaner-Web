# Processor env for local dev
# Copy to .env and fill in real values

# Common
PROCESSOR_MODE=stream
APPLICATIONINSIGHTS_CONNECTION_STRING=
COSMOS_CONNECTION_STRING=
COSMOS_DB_NAME=AudioCleanerDB

# Streaming specific
STREAM_SESSION_SIGNING_KEY=dev-unsafe-key-change-me
AZURE_OPENAI_ENDPOINT=https://your-openai-endpoint.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CLEANUP_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_SPEECH_SERVICES_KEY=
AZURE_SPEECH_SERVICES_REGION=eastus
USE_SPEECH_SERVICES=true
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_KEY=

# Batch specific
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_STORAGE_CONNECTION_STRING=
QUEUE_NAME=video-processing-jobs
UPLOADS_CONTAINER_NAME=uploads
PROCESSED_CONTAINER_NAME=processed-videos
